{
  "buildCommand": "cd sales-mgmt && npm install && npm run build",
  "outputDirectory": "sales-mgmt/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/invoices/(.*)", "destination": "/api/invoices" },
    { "source": "/api/tasks/(.*)", "destination": "/api/tasks" },
    { "source": "/api/chats/(.*)", "destination": "/api/chats" },
    { "source": "/api/products/(.*)", "destination": "/api/products" },
    { "source": "/api/categories/(.*)", "destination": "/api/categories" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
